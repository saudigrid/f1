# ————— مزوّد النماذج (وكيل الصياغة + وكيل التدقيق) —————
# يكفي مفتاح واحد. المزوّد المستخدَم لكل وكيل يُضبط في
# src/lib/config/pipeline.ts ← agents

# Google Gemini — الافتراضي (بحث جوجل مدمج في وكيل التدقيق)
GOOGLE_API_KEY=

# Anthropic Claude — بديل أو مكمّل
ANTHROPIC_API_KEY=

# بلا أي منهما يعمل الموقع كاملاً على بيانات تجريبية، ويتوقف خط الأتمتة بهدوء.

# ————— قاعدة البيانات (Supabase) —————
# اتركها فارغة وسيقرأ الموقع من ملفات JSON محلية في src/data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ————— حماية مسار الأتمتة ولوحة التحكم —————
# سلسلة عشوائية طويلة — Vercel Cron يرسلها في ترويسة Authorization
CRON_SECRET=
# كلمة مرور لوحة المراجعة /admin
ADMIN_PASSWORD=

# ————— الإعلانات —————
# اتركه فارغاً لعرض المواضع الفارغة أثناء التطوير
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ————— الموقع —————
NEXT_PUBLIC_SITE_URL=http://localhost:3000
